{
    "name": "mnonm/hermes-laravel-deployer",
    "description": "Migraciones y arreglos de datos de deploy en un solo orden, mas versionado, para proyectos Laravel gobernados por Hermes",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "illuminate/console": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Mnonm\\HermesDeployer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mnonm\\HermesDeployer\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mnonm\\HermesDeployer\\HermesDeployerServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": [
            "@php vendor/bin/phpunit",
            "@php vendor/bin/pint --dirty --format agent",
            "@php vendor/bin/phpstan analyse"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "orchestra/testbench": "^11.2",
        "phpunit/phpunit": "^12.5",
        "laravel/pint": "^1.32",
        "phpstan/phpstan": "^2.2"
    }
}
